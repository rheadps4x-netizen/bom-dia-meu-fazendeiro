# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- UltraMsg (WhatsApp) -----
ULTRAMSG_INSTANCE_ID=instanceXXXXX
ULTRAMSG_TOKEN=your-ultramsg-token
ULTRAMSG_WEBHOOK_TOKEN=segredo-para-validar-webhook

# ----- Vercel Cron -----
# Defina em Vercel > Settings > Environment Variables e use Bearer <CRON_SECRET>
CRON_SECRET=gere-uma-string-aleatoria-longa

# ----- Cakto -----
CAKTO_WEBHOOK_SECRET=
NEXT_PUBLIC_CHECKOUT_URL=
NEXT_PUBLIC_CAKTO_TESTE=
NEXT_PUBLIC_CAKTO_PREMIUM=
NEXT_PUBLIC_CAKTO_PERSONALIZADO=

# ----- Tracking -----
# Opcional: preencha para ativar os scripts em producao.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# Protege /metricas e /api/analytics?token=...
METRICS_TOKEN=gere-um-token-privado
